NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: explicit site URL for invite emails (Netlify sets URL automatically)
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
# "Sign in with QUANTT" for club members (lib/quantt-ticket.ts): the same value as CONNECT_SECRET on the quantt-auth Worker
QUANTT_AUTH_SECRET=
# Optional, default https://auth.quantt.ca
QUANTT_AUTH_URL=
