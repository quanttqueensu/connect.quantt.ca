# Secrets and variables for the quantt-connect Worker (set them in the Cloudflare
# dashboard, or in .dev.vars for `npm run preview`). Bindings DB and FILES are in wrangler.jsonc.
RESEND_API_KEY=
FILES_SIGNING_KEY=
# Optional sender for sign-in and invite emails; its domain must be verified in Resend.
LOGIN_EMAIL_FROM=
# Site URL for links in emails and redirects
NEXT_PUBLIC_SITE_URL=https://connect.quantt.ca
# "Sign in with QUANTT" (lib/quantt-signin.ts). Optional, default https://auth.quantt.ca
QUANTT_AUTH_URL=
