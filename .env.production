# Read by `next build` (and so by the Workers Builds deploy). Public, not a secret: Next inlines
# NEXT_PUBLIC_* into the build, so it must be known here, not only as a Worker variable.
# lib/site-url.ts throws in production without it. For a local `npm run preview` on another
# origin, override it in .env.production.local.
NEXT_PUBLIC_SITE_URL=https://connect.quantt.ca
